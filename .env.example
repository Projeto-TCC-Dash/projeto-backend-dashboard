# Configurações do Servidor Fastify
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Conexão com o Banco de Dados MongoDB NoSQL
MONGODB_URI=mongodb://localhost:27017/financial_db

# Segredos de Segurança e Criptografia da Aplicação
JWT_SECRET=super_secret_jwt_key_minimum_32_characters_long_12345
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# [OPCIONAL / DESENVOLVIMENTO LOCAL]
# Chave de API do Google AI Studio (Gemini) para scripts locais de demonstração e teste.
# Consumida pelo script 'npm run seed' para auto-vincular a chave criptografada ao usuário de teste
# e pré-aquecer o cache de análise financeira do mês atual.
# Se omitida, o seed opera de forma 100% autônoma e offline sem falhas.
# Obtenha uma chave em: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=